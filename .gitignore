.vscode/

# --- Python cache ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Jupyter ---
.ipynb_checkpoints/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
*.swp

# --- Local environments / secrets ---
.env
.venv/
venv/
env/

# --- Temporary files ---
*.tmp
*.bak

# --- Experiment trackers ---
wandb/
mlruns/

# --- Large generated model/data artifacts ---
VAE/cache/
output/*
*.ckpt
*.pt
*.pth
*.h5ad
*.h5
*.npy
*.npz
*.parquet

# --- Generated figures (images) ---
*.png
*.jpg
*.jpeg
*.gif
*.svg

# --- Generated experiment outputs (train/sample/viz + matrix summaries) ---
# runs/ 配下は train(checkpoints/loss_details.csv) / sample(npz) / viz(png) など全て生成物。
runs/
work/*/experiments/

# --- Repository policy notes ---
# Do not ignore external_data/*.tsv.
# Do not ignore LegacyFiles/ unless the migration policy changes.
# Do not ignore work/ (code) — but work/*/runs/ と work/*/experiments/（生成物）は ignore する。
# 図を意図的に commit したい場合は `git add -f path/to.png`。